"use client";

import { useEffect, useRef, useState } from "react";
import { supabase } from "@/lib/supabase";
import DominoGame from "@/app/components/DominoGame";

type Player = {
  id: string;
  player_name: string;
  seat: number;
  connected: boolean;
};

type RoomInfo = {
  room_id: string;
  room_code: string;
  player_id: string;
  seat: number;
};

export default function Home() {
  const [playerName, setPlayerName] = useState("");
  const [joinCode, setJoinCode] = useState("");
  const [room, setRoom] = useState<RoomInfo | null>(null);
  const [players, setPlayers] = useState<Player[]>([]);
  const [message, setMessage] = useState("");
  const [loading, setLoading] = useState(false);
  const [userReady, setUserReady] = useState(false);
  const [shareLink, setShareLink] = useState("");
  const [gameStarted, setGameStarted] = useState(false);
  const [roomStatus, setRoomStatus] = useState<"waiting" | "playing" | "finished">("waiting");

  const autoJoinAttempted = useRef(false);

  async function ensureAnonymousAuth() {
    const { data: sessionData, error: sessionError } =
      await supabase.auth.getSession();

    if (sessionError) {
      throw new Error(`Gagal memeriksa sesi: ${sessionError.message}`);
    }

    if (sessionData.session?.user) {
      setUserReady(true);
      return sessionData.session.user;
    }

    const { data, error } = await supabase.auth.signInAnonymously();

    if (error) {
      throw new Error(`Anonymous Auth gagal: ${error.message}`);
    }

    if (!data.user) {
      throw new Error("User anonymous tidak berhasil dibuat.");
    }

    setUserReady(true);
    return data.user;
  }

  useEffect(() => {
    let mounted = true;

    async function prepareAuth() {
      try {
        await ensureAnonymousAuth();

        if (mounted) {
          setUserReady(true);
        }
      } catch (error) {
        if (!mounted) return;

        const text =
          error instanceof Error ? error.message : "Gagal menyiapkan koneksi.";
        setMessage(text);
      }
    }

    prepareAuth();

    const savedName = window.localStorage.getItem("domino-player-name");

    if (savedName) {
      setPlayerName(savedName);
    }

    return () => {
      mounted = false;
    };
  }, []);

  useEffect(() => {
    if (!room?.room_id) return;

    const roomId = room.room_id;
    let mounted = true;

    async function loadRoomStatus() {
      const { data, error } = await supabase
        .from("rooms")
        .select("status")
        .eq("id", roomId)
        .single();

      if (!mounted || error) return;

      const status = data.status as "waiting" | "playing" | "finished";

      setRoomStatus(status);
      setGameStarted(status === "playing");
    }

    async function loadPlayers() {
      const { data, error } = await supabase
        .from("players")
        .select("id, player_name, seat, connected")
        .eq("room_id", roomId)
        .order("seat", { ascending: true });

      if (!mounted) return;

      if (error) {
        setMessage(`Gagal memuat pemain: ${error.message}`);
        return;
      }

      setPlayers(data ?? []);
    }

    loadRoomStatus();
    loadPlayers();

    const channel = supabase
      .channel(`domino-room-${roomId}`)
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "rooms",
          filter: `id=eq.${roomId}`,
        },
        (payload) => {
          const next = payload.new as {
            status?: "waiting" | "playing" | "finished";
          };

          const status = next.status;

          if (!status) return;

          setRoomStatus(status);
          setGameStarted(status === "playing");
        }
      )
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "players",
          filter: `room_id=eq.${roomId}`,
        },
        () => {
          loadRoomStatus();
    loadPlayers();
        }
      )
      .subscribe();

    return () => {
      mounted = false;
      supabase.removeChannel(channel);
    };
  }, [room?.room_id]);

  useEffect(() => {
    if (!room) {
      setShareLink("");
      return;
    }

    setShareLink(
      `${window.location.origin}/?room=${encodeURIComponent(room.room_code)}`
    );
  }, [room]);

  async function joinRoomByCode(codeInput: string, nameInput: string) {
    const code = codeInput.trim().toUpperCase();
    const name = nameInput.trim() || "Player";

    if (!/^[A-Z0-9]{4}$/.test(code)) {
      throw new Error("Masukkan kode room 4 karakter.");
    }

    const user = await ensureAnonymousAuth();

    window.localStorage.setItem("domino-player-name", name);

    const { data, error } = await supabase.rpc("join_domino_room", {
      p_code: code,
      p_player_name: name,
    });

    if (error) {
      /*
       * Kalau user ini ternyata sudah pernah masuk room yang sama,
       * kita coba ambil player existing supaya link tetap seamless.
       */
      const { data: existingRoom } = await supabase
        .from("rooms")
        .select("id, code, status")
        .eq("code", code)
        .maybeSingle();

      if (existingRoom) {
        const { data: existingPlayer } = await supabase
          .from("players")
          .select("id, player_name, seat, connected")
          .eq("room_id", existingRoom.id)
          .eq("user_id", user.id)
          .maybeSingle();

        if (existingPlayer) {
          setRoom({
            room_id: existingRoom.id,
            room_code: existingRoom.code,
            player_id: existingPlayer.id,
            seat: existingPlayer.seat,
          });
          setMessage(`Sudah berada di room ${code}.`);
          return;
        }
      }

      const raw = error.message;

      if (raw.includes("ROOM_NOT_FOUND")) {
        throw new Error("Room tidak ditemukan.");
      }

      if (raw.includes("ROOM_FULL")) {
        throw new Error("Room sudah penuh.");
      }

      if (raw.includes("ROOM_NOT_WAITING")) {
        throw new Error("Game room sudah dimulai.");
      }

      throw new Error(`Gagal join room: ${raw}`);
    }

    const rawResult = Array.isArray(data) ? data[0] : data;

    if (!rawResult?.room_id) {
      throw new Error("Join berhasil dipanggil tetapi room_id tidak diterima.");
    }

    let roomCode = rawResult.room_code;

    if (!roomCode) {
      const { data: roomData, error: roomError } = await supabase
        .from("rooms")
        .select("id, code")
        .eq("id", rawResult.room_id)
        .single();

      if (roomError) {
        throw new Error(`Gagal mengambil kode room: ${roomError.message}`);
      }

      roomCode = roomData.code;
    }

    setRoom({
      room_id: rawResult.room_id,
      room_code: roomCode,
      player_id: rawResult.player_id,
      seat: rawResult.seat,
    });

    setMessage(`Berhasil masuk ke room ${roomCode}.`);
  }

  async function handleCreateRoom() {
    setLoading(true);
    setMessage("");

    try {
      const user = await ensureAnonymousAuth();
      const name = playerName.trim() || "Player";

      window.localStorage.setItem("domino-player-name", name);

      const { data, error } = await supabase.rpc("create_domino_room", {
        p_player_name: name,
      });

      if (error) {
        throw new Error(`Gagal membuat room: ${error.message}`);
      }

      const rawResult = Array.isArray(data) ? data[0] : data;

      if (!rawResult?.room_id) {
        throw new Error("Room tidak berhasil dibuat.");
      }

      let roomCode = rawResult.room_code;

      if (!roomCode) {
        const { data: roomData, error: roomError } = await supabase
          .from("rooms")
          .select("id, code")
          .eq("id", rawResult.room_id)
          .single();

        if (roomError) {
          throw new Error(`Gagal mengambil kode room: ${roomError.message}`);
        }

        roomCode = roomData.code;
      }

      const newRoom: RoomInfo = {
        room_id: rawResult.room_id,
        room_code: roomCode,
        player_id: rawResult.player_id,
        seat: rawResult.seat,
      };

      setRoom(newRoom);
      setPlayers([
        {
          id: newRoom.player_id,
          player_name: name,
          seat: newRoom.seat,
          connected: true,
        },
      ]);

      setMessage(`Room ${roomCode} berhasil dibuat.`);

      void user;
    } catch (error) {
      const text =
        error instanceof Error ? error.message : "Terjadi kesalahan.";
      setMessage(text);
    } finally {
      setLoading(false);
    }
  }

  async function handleStartGame() {
    if (!room) return;

    if (players.length < 2) {
      setMessage("Minimal 2 pemain untuk memulai game.");
      return;
    }

    setLoading(true);
    setMessage("");

    try {
      const { error } = await supabase.rpc("start_domino_game", {
        p_room_id: room.room_id,
      });

      if (error) {
        if (error.message.includes("NOT_HOST")) {
          throw new Error("Hanya host yang bisa memulai game.");
        }

        if (error.message.includes("NOT_ENOUGH_PLAYERS")) {
          throw new Error("Minimal 2 pemain untuk memulai game.");
        }

        throw new Error(error.message);
      }

      setGameStarted(true);
      setMessage("Game dimulai!");
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Gagal memulai game.");
    } finally {
      setLoading(false);
    }
  }

  async function handleJoinRoom() {
    setLoading(true);
    setMessage("");

    try {
      await joinRoomByCode(joinCode, playerName);
    } catch (error) {
      const text =
        error instanceof Error ? error.message : "Terjadi kesalahan.";
      setMessage(text);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    if (!userReady || room || autoJoinAttempted.current) return;

    const params = new URLSearchParams(window.location.search);
    const code = (params.get("room") ?? "").trim().toUpperCase();

    if (!/^[A-Z0-9]{4}$/.test(code)) return;

    autoJoinAttempted.current = true;
    setJoinCode(code);

    const savedName =
      window.localStorage.getItem("domino-player-name")?.trim() ?? "";

    if (!savedName) {
      setMessage("Link room terdeteksi. Masukkan nama pemain untuk masuk.");
      return;
    }

    setPlayerName(savedName);
    setLoading(true);

    void joinRoomByCode(code, savedName)
      .catch((error) => {
        const text =
          error instanceof Error ? error.message : "Gagal masuk ke room.";
        setMessage(text);
      })
      .finally(() => {
        setLoading(false);
      });
  }, [userReady, room]);

  async function copyText(text: string, successMessage: string) {
    try {
      await navigator.clipboard.writeText(text);
      setMessage(successMessage);
    } catch {
      setMessage("Clipboard tidak tersedia di browser ini.");
    }
  }

  async function shareRoom() {
    if (!room || !shareLink) return;

    const shareData = {
      title: "Domino Multiplayer",
      text: `Gabung room Domino saya: ${room.room_code}`,
      url: shareLink,
    };

    if (navigator.share) {
      try {
        await navigator.share(shareData);
        setMessage("Link room siap dibagikan.");
        return;
      } catch {
        // User menutup share sheet. Tidak perlu menampilkan error.
      }
    }

    await copyText(shareLink, "Link room disalin.");
  }

  function leaveRoom() {
    setRoom(null);
    setPlayers([]);
    setMessage("Kamu keluar dari room.");

    window.history.replaceState(
      null,
      "",
      window.location.pathname
    );
  }

  const connectedPlayers = players.length;
  const isPlaying = roomStatus === "playing" || gameStarted;

  if (isPlaying && room) {
    return (
      <DominoGame
        roomId={room.room_id}
        roomCode={room.room_code}
        playerId={room.player_id}
        players={players}
        onShare={shareRoom}
        onLeave={leaveRoom}
      />
    );
  }

  return (
    <main className="min-h-screen bg-[#071A24] text-white">
      <div className="relative min-h-screen overflow-hidden">
        <div className="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(200,155,60,0.14),transparent_38%)]" />
        <div className="absolute inset-0 bg-[radial-gradient(circle_at_bottom_right,rgba(35,104,124,0.18),transparent_35%)]" />

        <div className="relative mx-auto flex min-h-screen w-full max-w-6xl items-center justify-center px-5 py-12">
          <div className="w-full max-w-3xl">
            <div className="mb-8 text-center">
              <p className="text-[10px] font-bold uppercase tracking-[0.4em] text-[#C89B3C]">
                Multiplayer Domino
              </p>

              <h1 className="mt-4 text-5xl font-semibold tracking-[-0.04em] sm:text-6xl">
                DOMINO
              </h1>

              <p className="mx-auto mt-4 max-w-md text-sm leading-6 text-white/50">
                Buat room, undang teman, dan bermain domino secara real-time.
              </p>
            </div>

            {!room ? (
              <>
                <div className="mb-5 rounded-[2rem] border border-white/10 bg-[#0B2632]/90 p-5 shadow-2xl shadow-black/30 backdrop-blur-xl sm:p-7">
                  <div>
                    <label
                      htmlFor="player-name"
                      className="text-[10px] font-bold uppercase tracking-[0.2em] text-white/45"
                    >
                      Nama Pemain
                    </label>

                    <input
                      id="player-name"
                      value={playerName}
                      onChange={(event) => setPlayerName(event.target.value)}
                      placeholder="Nama kamu"
                      maxLength={24}
                      className="mt-3 w-full rounded-2xl border border-white/10 bg-[#061923] px-5 py-4 text-sm font-medium text-white outline-none transition focus:border-[#C89B3C]/60"
                    />
                  </div>

                  <button
                    type="button"
                    onClick={handleCreateRoom}
                    disabled={loading}
                    className="mt-5 w-full rounded-2xl bg-[#C89B3C] px-5 py-4 text-sm font-black tracking-[0.18em] text-[#061923] transition hover:brightness-105 disabled:cursor-not-allowed disabled:opacity-60"
                  >
                    {loading ? "MENYIAPKAN..." : "CREATE ROOM"}
                  </button>

                  <div className="my-7 flex items-center gap-4">
                    <div className="h-px flex-1 bg-white/10" />
                    <span className="text-[10px] font-bold uppercase tracking-[0.2em] text-white/30">
                      OR
                    </span>
                    <div className="h-px flex-1 bg-white/10" />
                  </div>

                  <label
                    htmlFor="join-code"
                    className="text-[10px] font-bold uppercase tracking-[0.2em] text-white/45"
                  >
                    Join Room
                  </label>

                  <div className="mt-3 flex gap-3">
                    <input
                      id="join-code"
                      value={joinCode}
                      onChange={(event) =>
                        setJoinCode(event.target.value.toUpperCase())
                      }
                      placeholder="A7K9"
                      maxLength={4}
                      className="min-w-0 flex-1 rounded-2xl border border-white/10 bg-[#061923] px-5 py-4 text-center text-lg font-black tracking-[0.35em] text-white outline-none transition focus:border-[#C89B3C]/60"
                    />

                    <button
                      type="button"
                      onClick={handleJoinRoom}
                      disabled={loading}
                      className="rounded-2xl border border-white/10 px-7 py-4 text-sm font-black tracking-[0.12em] transition hover:bg-white/5 disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      JOIN
                    </button>
                  </div>

                  <div className="mt-5 rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3 text-center text-xs text-white/50">
                    {message ||
                      (userReady
                        ? "Koneksi game siap."
                        : "Menyiapkan koneksi game...")}
                  </div>
                </div>

                <div className="grid grid-cols-3 gap-3">
                  <div className="rounded-2xl border border-white/10 bg-[#0B2632]/75 px-4 py-5 text-center">
                    <div className="text-lg font-black">2-4</div>
                    <div className="mt-1 text-[9px] font-bold uppercase tracking-[0.16em] text-white/30">
                      Players
                    </div>
                  </div>

                  <div className="rounded-2xl border border-white/10 bg-[#0B2632]/75 px-4 py-5 text-center">
                    <div className="text-lg font-black">Realtime</div>
                    <div className="mt-1 text-[9px] font-bold uppercase tracking-[0.16em] text-white/30">
                      Multiplayer
                    </div>
                  </div>

                  <div className="rounded-2xl border border-white/10 bg-[#0B2632]/75 px-4 py-5 text-center">
                    <div className="text-lg font-black">Online</div>
                    <div className="mt-1 text-[9px] font-bold uppercase tracking-[0.16em] text-white/30">
                      Browser
                    </div>
                  </div>
                </div>
              </>
            ) : (
              <div className="rounded-[2rem] border border-[#C89B3C]/40 bg-[#0B2632]/90 p-5 shadow-2xl shadow-black/30 backdrop-blur-xl sm:p-8">
                <div className="text-center">
                  <p className="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40">
                    Room Code
                  </p>

                  <div className="mt-3 text-5xl font-black tracking-[0.25em] text-[#C89B3C] sm:text-6xl">
                    {room.room_code}
                  </div>

                  <p className="mt-3 text-sm text-white/45">
                    Bagikan link ini kepada pemain lain.
                  </p>
                </div>

                <div className="my-7 h-px bg-white/10" />

                <div>
                  <label
                    htmlFor="share-link"
                    className="text-[10px] font-bold uppercase tracking-[0.2em] text-white/40"
                  >
                    Share Link
                  </label>

                  <div className="mt-3 flex gap-3">
                    <input
                      id="share-link"
                      value={shareLink}
                      readOnly
                      className="min-w-0 flex-1 rounded-2xl border border-white/10 bg-[#061923] px-4 py-3 text-xs text-white/60 outline-none"
                    />

                    <button
                      type="button"
                      onClick={() =>
                        copyText(shareLink, "Link room disalin.")
                      }
                      className="rounded-2xl border border-white/10 px-5 py-3 text-[10px] font-black tracking-[0.12em] hover:bg-white/5"
                    >
                      COPY
                    </button>
                  </div>

                  <button
                    type="button"
                    onClick={shareRoom}
                    className="mt-3 w-full rounded-2xl bg-[#C89B3C] px-5 py-4 text-sm font-black tracking-[0.16em] text-[#061923] transition hover:brightness-105"
                  >
                    SHARE ROOM
                  </button>

                  {!gameStarted && room.seat === 1 && (
                    <button
                      type="button"
                      onClick={handleStartGame}
                      disabled={loading || players.length < 2}
                      className="mt-3 w-full rounded-2xl border border-[#C89B3C]/50 bg-[#C89B3C]/10 px-5 py-4 text-sm font-black tracking-[0.16em] text-[#C89B3C] transition hover:bg-[#C89B3C]/20 disabled:cursor-not-allowed disabled:opacity-40"
                    >
                      {players.length < 2
                        ? "WAITING FOR PLAYERS..."
                        : "START GAME"}
                    </button>
                  )}


                </div>

                <div className="my-7 h-px bg-white/10" />

                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-[10px] font-bold uppercase tracking-[0.22em] text-white/40">
                      Players
                    </p>
                    <p className="mt-1 text-sm text-white/60">
                      {connectedPlayers} / 4 pemain
                    </p>
                  </div>

                  <span className="rounded-full border border-[#C89B3C]/40 bg-[#C89B3C]/10 px-4 py-2 text-[10px] font-black uppercase tracking-[0.14em] text-[#C89B3C]">
                    {isPlaying ? "PLAYING" : "WAITING"}
                  </span>
                </div>

                <div className="mt-5 space-y-3">
                  {[1, 2, 3, 4].map((seat) => {
                    const player = players.find(
                      (item) => item.seat === seat
                    );

                    return (
                      <div
                        key={seat}
                        className="flex items-center gap-4 rounded-2xl border border-white/10 bg-[#061923] px-4 py-4"
                      >
                        <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 bg-[#0B2632] text-sm font-black text-[#C89B3C]">
                          {seat}
                        </div>

                        <div className="min-w-0 flex-1">
                          <div className="truncate text-sm font-bold">
                            {player?.player_name || "Waiting for player..."}
                          </div>

                          <div className="mt-1 text-[9px] font-bold uppercase tracking-[0.14em] text-white/25">
                            {player ? "CONNECTED" : "OPEN SEAT"}
                          </div>
                        </div>

                        {player && (
                          <div
                            className={`h-2.5 w-2.5 rounded-full ${
                              player.connected
                                ? "bg-emerald-400"
                                : "bg-white/20"
                            }`}
                          />
                        )}
                      </div>
                    );
                  })}
                </div>

                <div className="mt-5 rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3 text-center text-xs text-white/50">
                  {message || "Bagikan link room untuk mengundang teman."}
                </div>

                <button
                  type="button"
                  onClick={leaveRoom}
                  className="mt-5 w-full rounded-2xl border border-white/10 px-5 py-3 text-xs font-black tracking-[0.15em] text-white/45 hover:bg-white/5 hover:text-white"
                >
                  LEAVE ROOM
                </button>
              </div>
            )}

            <p className="mt-8 text-center text-[9px] font-bold uppercase tracking-[0.28em] text-white/20">
              Domino Multiplayer - Online Game
            </p>
          </div>
        </div>
      </div>
    </main>
  );
}







